#!/bin/sh
# atlas-rite-skill — generate the standalone /atlas skill from the rite source.
#
# The rite lives in runtime/compact-coda.md, inside a text fence. This lifts it
# into a personal skill so the Operator can wind the crown by typing /atlas.
#
# It is a STANDALONE skill, not one of the plugin's. Plugin skills are always
# namespaced — the best a plugin can offer is /atlas:atlas — and a personal
# skill is not, so a bare /atlas requires this to sit outside the plugin.
#
# The invocation name comes from the skill's DIRECTORY, not from the frontmatter
# `name`. Tested: a directory called atlas-rite registered as /atlas-rite even
# with `name: atlas` set. So the directory is `atlas`, and it installs to
# ~/.claude/skills/atlas. The plugin therefore installs somewhere else — the two
# cannot share that path, which is why the README does not put the plugin under
# ~/.claude/skills.
#
# Because it is not a plugin skill it cannot use ${CLAUDE_PLUGIN_ROOT}, and it
# cannot assume where the plugin lives. So the grade is read from the repository
# through ATLAS_REPO, falling back to a conventional checkout. A missing script
# degrades to no readout rather than a broken rite: the || true matters.
#
# Use:  bin/atlas-rite-skill            # write the skill
#       bin/atlas-rite-skill --check    # exit 1 if it is stale
set -eu
CDPATH=''

SOURCE=$0
while [ -h "$SOURCE" ]; do
  source_dir=$(cd -P "$(dirname "$SOURCE")" && pwd)
  SOURCE=$(readlink "$SOURCE")
  case $SOURCE in
    /*) ;;
    *) SOURCE=$source_dir/$SOURCE ;;
  esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$SOURCE")" && pwd)
REPO=$(cd -P "$SCRIPT_DIR/.." && pwd)

CHECK=0
[ "${1:-}" = "--check" ] && CHECK=1

CODA=$REPO/runtime/compact-coda.md
TARGET=$REPO/skills-standalone/atlas/SKILL.md
LEVEL_TARGET=$REPO/skills-standalone/atlas/level

# The rite is the first text fence in the coda. One extractor, so the panel has
# a single source and cannot be transcribed by hand into a third copy.
RITE=$(mktemp "${TMPDIR:-/tmp}/atlas-rite.XXXXXX") || exit 1
trap 'rm -f "$RITE" "$BUILT" "$LEVEL_BUILT"' EXIT INT TERM
awk '
  /^```text$/ { infence = 1; next }
  infence && /^```$/ { exit }
  infence { print }
' "$CODA" > "$RITE"

[ -s "$RITE" ] || {
  echo "atlas-rite-skill: no rite fence found in runtime/compact-coda.md" >&2
  exit 1
}

BUILT=$(mktemp "${TMPDIR:-/tmp}/atlas-riteskill.XXXXXX") || exit 1
LEVEL_BUILT=$(mktemp "${TMPDIR:-/tmp}/atlas-levelsh.XXXXXX") || exit 1

# Finds the repository and prints the level. Lives beside the skill because the
# skill is standalone: no ${CLAUDE_PLUGIN_ROOT}, and no way to know whether the
# plugin came from a marketplace cache or a checkout. Silence is the correct
# outcome when it cannot be found — the rite must still render.
cat > "$LEVEL_BUILT" <<'LEVELSH'
#!/bin/sh
# GENERATED by bin/atlas-rite-skill. Do not edit.
set -u
for dir in \
  ${ATLAS_REPO:+"$ATLAS_REPO"} \
  "$HOME"/.claude/plugins/cache/*/atlas \
  "$HOME"/projects/shadow-atlas \
  "$HOME"/projects/ATLAS
do
  if [ -f "$dir/level/level.py" ]; then
    python3 "$dir/level/level.py" --oneline 2>/dev/null
    exit 0
  fi
done
exit 0
LEVELSH

{
  printf -- '---\n'
  printf 'name: atlas\n'
  printf 'description: Wind the crown. Performs the Arrival rite and brings ATLAS online with the live level.\n'
  # The crown is the only way in, and it is the Operator's to turn. Claude must
  # not decide to perform the rite on its own.
  printf 'disable-model-invocation: true\n'
  printf -- '---\n\n'
  printf '<!-- GENERATED by bin/atlas-rite-skill. Do not edit this file. -->\n'
  printf '<!-- Edit the rite in runtime/compact-coda.md, then regenerate. -->\n\n'
  printf '# BOOT READOUT (computed at load)\n\n'
  # A standalone skill cannot use ${CLAUDE_PLUGIN_ROOT} and cannot know where
  # the plugin was installed. The search lives in a `level` script written
  # beside this skill rather than inline: a for-loop with globs inside the !
  # substitution silently produced no output at all, costing the whole readout.
  # One short command is what this syntax handles well.
  printf '!`"$HOME/.claude/skills/atlas/level" 2>/dev/null || true`\n\n'
  printf 'Perform the Arrival rite once. Reproduce the panel and the greeting\n'
  printf 'below, filling `<N>`, `<XP>`, and `<XP100>` from the BOOT READOUT\n'
  printf 'above and `<Operator>` from the active operator profile, or `Operator`\n'
  printf 'if no profile is loaded. Then stop and await the Operator.\n\n'
  printf '```text\n'
  cat "$RITE"
  printf '```\n'
} > "$BUILT"

if [ "$CHECK" -eq 1 ]; then
  if [ -f "$TARGET" ] && cmp -s "$BUILT" "$TARGET" &&
     [ -x "$LEVEL_TARGET" ] && cmp -s "$LEVEL_BUILT" "$LEVEL_TARGET"; then
    echo "atlas-rite-skill: the /atlas skill matches the rite source"
  else
    echo "atlas-rite-skill: stale; regenerate with bin/atlas-rite-skill" >&2
    exit 1
  fi
else
  mkdir -p "$(dirname "$TARGET")"
  cp "$BUILT" "$TARGET"
  cp "$LEVEL_BUILT" "$LEVEL_TARGET"
  chmod +x "$LEVEL_TARGET"
  echo "atlas-rite-skill: wrote the /atlas skill from the rite source"
fi
