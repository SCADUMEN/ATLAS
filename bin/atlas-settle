#!/bin/sh
# atlas-settle — the Stop hook. Reads the turn back once the barrel has acted.
#
# The council skills the barrel invoked this turn are its proposals: the skill
# names the member, its args are the reason. This routes the turn's prompt
# with them, records a settle entry when there were any, and draws Le Cadran's
# face of what actually convened - named and automatic together, once per
# turn. The logic is rouage/settle.py; this only finds it.
#
# A Stop hook must never block the turn. Nothing here returns 2.
#
#   ATLAS_NO_ROUTE=1       the hook does nothing
#   ATLAS_NO_WINDING=1     route and draw, but keep no log
#   ATLAS_WINDING_LOG=...  log here instead of ~/.claude/atlas/windings.jsonl
CDPATH=''
HERE=$(cd -P "$(dirname "$0")" && pwd) || exit 0

# -I for the same reason as atlas-route: the Operator's working directory must
# not be able to shadow a module. settle.py puts its own directory on the path.
python3 -I "$HERE/../rouage/settle.py" 2>/dev/null || true
