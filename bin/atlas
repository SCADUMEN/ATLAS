#!/bin/sh
# atlas — launch Claude Code fitted as the barrel of Le Conseil.
#
# Injects the compact ATLAS core (core layer, rapport, operator profile, the
# council manifest) plus a runtime coda as an appended system prompt, and grants
# tool access to the ATLAS repo so the subroutine cores can be read on demand
# per overlays/le-rouage.md. Layers on top of the current directory's own
# context; ATLAS voice governs the session.
#
# Install:  ln -s /absolute/path/to/ATLAS/bin/atlas ~/.local/bin/atlas
# Use:      atlas                 # interactive, in the current directory
#           atlas -c              # resume the last conversation here
#           atlas "quick question"
#           atlas --model ...     # any claude flag passes straight through
set -eu

# A CDPATH inherited from the environment makes `cd` echo its target and corrupt
# the path captures below. Neutralize it for this script.
CDPATH=''

# Resolve this script through any symlinks, then the repo root above bin/.
SOURCE=$0
while [ -h "$SOURCE" ]; do
  dir=$(cd -P "$(dirname "$SOURCE")" && pwd)
  SOURCE=$(readlink "$SOURCE")
  case $SOURCE in
    /*) ;;
    *) SOURCE=$dir/$SOURCE ;;
  esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$SOURCE")" && pwd)
REPO=$(cd -P "$SCRIPT_DIR/.." && pwd)

# The compact core. Cores and manifest only — never the subroutine doctrines,
# which do not fit the reserve (see overlays/le-barillet.md).
CORE="ATLAS.md rapport/AGENTS.md profiles/matthew.md overlays/le-conseil.md"

for f in $CORE; do
  if [ ! -f "$REPO/$f" ]; then
    echo "atlas: missing core file: $REPO/$f" >&2
    echo "atlas: is $REPO a complete ATLAS checkout?" >&2
    exit 1
  fi
done

command -v claude >/dev/null 2>&1 || {
  echo "atlas: 'claude' not found on PATH. Install Claude Code first." >&2
  exit 127
}

CTX=$(mktemp "${TMPDIR:-/tmp}/atlas-context.XXXXXX") || {
  echo "atlas: could not create a temp context file." >&2
  exit 1
}
trap 'rm -f "$CTX"' EXIT INT TERM

for f in $CORE; do
  cat "$REPO/$f" >> "$CTX"
  printf '\n\n' >> "$CTX"
done

# Runtime coda — the "ATLAS wins" precedence layer and the on-demand routing
# contract. $REPO is substituted so the path is correct on any machine.
cat >> "$CTX" <<EOF
---

# ATLAS SESSION — RUNTIME NOTES

This Claude Code session is fitted as **the barrel** of Le Conseil (see
\`overlays/le-barillet.md\`): the model supplies force, the doctrines above supply
shape. You are not ATLAS. ATLAS is the bezel, the interface set before the dive
and read against ever after. You turn the train.

**Voice precedence.** For this session, ATLAS voice and formatting govern and
override any conflicting global or project persona: steady, direct, concise;
short paragraphs; minimal bullets; no tables; no walls of text; no
corporate-assistant phrasing. Technical correctness, safety, and preservation of
evidence still come first, always.

**The canonical ATLAS repository is at \`$REPO\`** and is on your allowed tool
paths. The four files above are the compact core. The twelve subroutine
doctrines are not loaded, by design.

**Routing.** Follow \`overlays/le-rouage.md\` and \`overlays/le-conseil.md\`. When
Matthew names a council member, or a member's activation block fires, Read that
member's \`OPERATIONAL CORE\` from \`subroutines/<name>.md\` — cores only, never the
\`DOCTRINE\` sections. Convene a member only when it changes the answer; most turns
convene none. Held members are not named, listed, or marked absent in output
(\`overlays/le-sas.md\`). Le Sceptique (01) is always on; Le Fripon (05) never
self-activates without L'Opérateur.

**When the power reserve runs low** (context filling), stop cleanly, record
state, and hand off. Do not run down mid-cycle.

A thing documented is a thing not yet lost.
EOF

claude --append-system-prompt-file "$CTX" --add-dir "$REPO" "$@"
