#!/bin/sh
# atlas-skills — generate the council skills from the subroutine sources.
#
# Each subroutine file carries two sections: OPERATIONAL CORE, which a router
# loads, and DOCTRINE, which is the authoring layer and must never reach a
# working context. Today that separation is a sentence in the coda that the
# model is asked to honour, and overlays/le-rouage.md admits the enforcement is
# not wired to anything.
#
# A skill makes it structural. This writes skills/<name>/SKILL.md containing
# the OPERATIONAL CORE alone, so the doctrine is not merely unrequested — it is
# absent from the file the harness loads.
#
# Use:  bin/atlas-skills            # write every skill
#       bin/atlas-skills --check    # exit 1 if any skill is stale
set -eu
CDPATH=''

SOURCE=$0
while [ -h "$SOURCE" ]; do
  source_dir=$(cd -P "$(dirname "$SOURCE")" && pwd)
  SOURCE=$(readlink "$SOURCE")
  case $SOURCE in
    /*) ;;
    *) SOURCE=$source_dir/$SOURCE ;;
  esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$SOURCE")" && pwd)
REPO=$(cd -P "$SCRIPT_DIR/.." && pwd)

CHECK=0
[ "${1:-}" = "--check" ] && CHECK=1

STALE=0

# Le Fripon never self-activates without L'Opérateur. As frontmatter that stops
# being a rule the model has to remember and becomes one the harness enforces:
# Claude cannot load him on its own initiative, only /atlas:le-fripon reaches
# him. Le Sceptique is standing and always on, so his core is already inline in
# the agent; the skill exists for when the Operator names him.
sealed_member() {
  case $1 in
    le-fripon) return 0 ;;
    *) return 1 ;;
  esac
}

# The first paragraph of the Activation block, folded to one line. It already
# reads as a trigger list — "Invoke him when the Operator names X" — which is
# what a skill description is for.
activation_line() {
  awk '
    /^## OPERATIONAL CORE/ { core = 1; next }
    /^## DOCTRINE/ { exit }
    core && /^\*\*Always on\.\*\*/ { print; exit }
    core && /^Invoke/ { print; exit }
    core && /^\*\*Invoke/ { print; exit }
  ' "$1" | sed 's/\*\*//g; s/`//g' | cut -c1-320
}

while IFS= read -r file || [ -n "$file" ]; do
  case $file in ''|'#'*) continue ;; esac
  [ -f "$REPO/$file" ] || {
    echo "atlas-skills: missing subroutine: $REPO/$file" >&2
    exit 1
  }

  name=$(basename "$file" .md)
  title=$(awk 'NR==1 { sub(/^# /, ""); print; exit }' "$REPO/$file")
  trigger=$(activation_line "$REPO/$file")
  [ -n "$trigger" ] || {
    echo "atlas-skills: no activation line found in $file" >&2
    exit 1
  }

  target=$REPO/skills/$name/SKILL.md
  built=$(mktemp "${TMPDIR:-/tmp}/atlas-skill.XXXXXX") || exit 1

  {
    printf -- '---\n'
    printf 'name: %s\n' "$name"
    printf 'description: %s — %s\n' "$title" "$trigger"
    if sealed_member "$name"; then
      printf 'disable-model-invocation: true\n'
    fi
    printf -- '---\n\n'
    printf '<!-- GENERATED by bin/atlas-skills. Do not edit this file. -->\n'
    printf '<!-- Edit %s, then regenerate. -->\n\n' "$file"
    # OPERATIONAL CORE only. The same two boundary headers atlas-context keys
    # on, so one definition of "core" serves both the bundle and the skills.
    awk '
      /^## OPERATIONAL CORE[[:space:]]*$/ { in_core = 1 }
      /^## DOCTRINE[[:space:]]*$/ { in_core = 0 }
      in_core { print }
    ' "$REPO/$file"
  } > "$built"

  if [ "$CHECK" -eq 1 ]; then
    if [ ! -f "$target" ] || ! cmp -s "$built" "$target"; then
      echo "atlas-skills: stale: skills/$name/SKILL.md" >&2
      STALE=1
    fi
  else
    mkdir -p "$REPO/skills/$name"
    cp "$built" "$target"
  fi
  rm -f "$built"
done < "$REPO/runtime/subroutine-files.txt"

if [ "$CHECK" -eq 1 ]; then
  [ "$STALE" -eq 0 ] || {
    echo "atlas-skills: regenerate with bin/atlas-skills" >&2
    exit 1
  }
  echo "atlas-skills: every council skill matches its subroutine source"
else
  echo "atlas-skills: wrote council skills from subroutines"
fi
