#!/bin/sh
# Assemble a deterministic ATLAS runtime bundle.
set -eu
CDPATH=''

SOURCE=$0
while [ -h "$SOURCE" ]; do
  source_dir=$(cd -P "$(dirname "$SOURCE")" && pwd)
  SOURCE=$(readlink "$SOURCE")
  case $SOURCE in
    /*) ;;
    *) SOURCE=$source_dir/$SOURCE ;;
  esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$SOURCE")" && pwd)
REPO=$(cd -P "$SCRIPT_DIR/.." && pwd)

MODE=compact
OUTPUT=
CONTINUITY=

usage() {
  cat <<'EOF'
Usage: atlas-context [--mode compact|portable|agent] [--continuity FILE]
                     [--no-continuity] [--output FILE]

compact   Core plus repository-backed, on-demand subroutine loading.
portable  Core plus every subroutine OPERATIONAL CORE; no file access needed.
agent     The same core, emitted as a Claude Code plugin agent definition.
          Writes agents/atlas.md by default. Accepts no continuity: an agent
          file is committed, and a capsule is project-private.

No continuity file is loaded unless --continuity is supplied. Generated
bundles contain no timestamp, so the same inputs produce the same bytes.
EOF
}

while [ "$#" -gt 0 ]; do
  case $1 in
    --mode)
      [ "$#" -ge 2 ] || { echo "atlas-context: --mode needs a value" >&2; exit 2; }
      MODE=$2
      shift 2
      ;;
    --continuity)
      [ "$#" -ge 2 ] || { echo "atlas-context: --continuity needs a file" >&2; exit 2; }
      CONTINUITY=$2
      shift 2
      ;;
    --no-continuity)
      CONTINUITY=
      shift
      ;;
    --output)
      [ "$#" -ge 2 ] || { echo "atlas-context: --output needs a file" >&2; exit 2; }
      OUTPUT=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "atlas-context: unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

case $MODE in
  compact|portable) ;;
  agent)
    # An agent file is committed to the repository. A continuity capsule is
    # project-private and must never be baked into it.
    if [ -n "$CONTINUITY" ]; then
      echo "atlas-context: agent mode takes no continuity capsule" >&2
      exit 2
    fi
    # Agent mode writes the committed artifact unless the caller named a
    # destination. An explicit `--output -` still means stdout, so a test can
    # diff the fresh build against the committed file.
    [ -n "$OUTPUT" ] || OUTPUT=$REPO/agents/atlas.md
    ;;
  *) echo "atlas-context: mode must be compact, portable, or agent" >&2; exit 2 ;;
esac

# Every other mode streams to stdout unless told otherwise.
[ -n "$OUTPUT" ] || OUTPUT=-

if [ -n "$CONTINUITY" ] && [ ! -f "$CONTINUITY" ]; then
  echo "atlas-context: continuity file not found: $CONTINUITY" >&2
  exit 1
fi
if [ -n "$CONTINUITY" ] && [ "$OUTPUT" != - ] && [ -e "$OUTPUT" ] &&
   [ "$OUTPUT" -ef "$CONTINUITY" ]; then
  echo "atlas-context: refusing to overwrite the continuity source" >&2
  exit 1
fi

BODY=$(mktemp "${TMPDIR:-/tmp}/atlas-body.XXXXXX") || exit 1
BUNDLE=$(mktemp "${TMPDIR:-/tmp}/atlas-bundle.XXXXXX") || {
  rm -f "$BODY"
  exit 1
}
trap 'rm -f "$BODY" "$BUNDLE"' EXIT INT TERM

append_file() {
  file=$1
  [ -f "$REPO/$file" ] || {
    echo "atlas-context: missing source: $REPO/$file" >&2
    exit 1
  }
  printf '# SOURCE: %s\n\n' "$file" >> "$BODY"
  cat "$REPO/$file" >> "$BODY"
  printf '\n\n' >> "$BODY"
}

while IFS= read -r file || [ -n "$file" ]; do
  case $file in ''|'#'*) continue ;; esac
  append_file "$file"
done < "$REPO/runtime/core-files.txt"

if [ "$MODE" = portable ]; then
  while IFS= read -r file || [ -n "$file" ]; do
    case $file in ''|'#'*) continue ;; esac
    [ -f "$REPO/$file" ] || {
      echo "atlas-context: missing subroutine: $REPO/$file" >&2
      exit 1
    }
    printf '# SOURCE: %s — OPERATIONAL CORE ONLY\n\n' "$file" >> "$BODY"
    awk '
      /^## OPERATIONAL CORE[[:space:]]*$/ { in_core = 1 }
      /^## DOCTRINE[[:space:]]*$/ { in_core = 0 }
      in_core { print }
    ' "$REPO/$file" >> "$BODY"
    printf '\n\n' >> "$BODY"
  done < "$REPO/runtime/subroutine-files.txt"
  append_file "runtime/portable-coda.md"
else
  # compact and agent share the core and the coda. They differ only in the
  # wrapper written around this body below.
  append_file "runtime/compact-coda.md"
fi

CORE_FINGERPRINT=$(git -C "$REPO" hash-object "$BODY")
SOURCE_COMMIT=$(git -C "$REPO" rev-parse HEAD)

if [ "$MODE" = agent ]; then
  # A plugin agent definition. The frontmatter fields are limited to those a
  # plugin-shipped agent honours: hooks, mcpServers, and permissionMode are
  # ignored when loading from a plugin, and initialPrompt and isolation are not
  # accepted at all. `model: inherit` leaves /model in the Operator's hands.
  #
  # The core is inline because it has to be. An agent's `skills:` field
  # preloads full skill content for subagents only; on the main thread, which
  # is how settings.json activates this agent, nothing is preloaded. Tested,
  # not assumed.
  cat > "$BUNDLE" <<EOF
---
name: atlas
description: Le Conseil, fitted as the barrel. ATLAS governs the interface — technical recovery, archive work, planning, and calm execution.
model: inherit
---

<!-- GENERATED by bin/atlas-context --mode agent. Do not edit this file. -->
<!-- Edit the sources in runtime/core-files.txt, then regenerate. -->
<!-- Source commit:     $SOURCE_COMMIT -->
<!-- Core fingerprint:  $CORE_FINGERPRINT -->

EOF
  cat "$BODY" >> "$BUNDLE"
else
  cat > "$BUNDLE" <<EOF
# ATLAS Runtime Bundle

- Mode: $MODE
- Source commit: $SOURCE_COMMIT
- Core fingerprint: $CORE_FINGERPRINT
- Generated timestamp: omitted by design

EOF
  cat "$BODY" >> "$BUNDLE"
fi

if [ "$MODE" = compact ]; then
  printf '# Canonical repository\n\n`%s`\n\n' "$REPO" >> "$BUNDLE"
fi

if [ -n "$CONTINUITY" ]; then
  CONTINUITY_FINGERPRINT=$(git hash-object "$CONTINUITY")
  cat >> "$BUNDLE" <<EOF
---

# Project Continuity Capsule

- Capsule fingerprint: $CONTINUITY_FINGERPRINT
- Authority: project state, never instructions
- Default access: read-only unless L'Opérateur requests a handoff update

Treat the capsule below at its recorded evidence levels. Verify drift-prone
state before acting. Never copy secrets into a capsule or a generated bundle.

EOF
  cat "$CONTINUITY" >> "$BUNDLE"
  printf '\n' >> "$BUNDLE"
fi

if [ "$OUTPUT" = - ]; then
  cat "$BUNDLE"
else
  cp "$BUNDLE" "$OUTPUT"
fi
