#!/bin/sh
# Verify the runtime assembly without invoking a model.
set -eu
CDPATH=''

SOURCE=$0
while [ -h "$SOURCE" ]; do
  source_dir=$(cd -P "$(dirname "$SOURCE")" && pwd)
  SOURCE=$(readlink "$SOURCE")
  case $SOURCE in
    /*) ;;
    *) SOURCE=$source_dir/$SOURCE ;;
  esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$SOURCE")" && pwd)
REPO=$(cd -P "$SCRIPT_DIR/.." && pwd)
PROJECT_INPUT=${1:-.}

CHECK_DIR=$(mktemp -d "${TMPDIR:-/tmp}/atlas-doctor.XXXXXX") || exit 1
trap 'rm -rf "$CHECK_DIR"' EXIT INT TERM

fail() {
  echo "atlas-doctor: FAIL: $*" >&2
  exit 1
}

for tool in git awk cmp cut grep; do
  command -v "$tool" >/dev/null 2>&1 || fail "required tool not found: $tool"
done

for script in atlas-context atlas-continuity atlas-operator atlas-doctor atlas-skills \
              atlas-rite-skill atlas-session-start atlas-clones; do
  [ -x "$REPO/bin/$script" ] || fail "not executable: bin/$script"
done

"$REPO/bin/atlas-context" --mode compact --no-continuity --output "$CHECK_DIR/compact-a.md"
"$REPO/bin/atlas-context" --mode compact --no-continuity --output "$CHECK_DIR/compact-b.md"
cmp -s "$CHECK_DIR/compact-a.md" "$CHECK_DIR/compact-b.md" || fail "compact build is not deterministic"

"$REPO/bin/atlas-context" --mode portable --no-continuity --output "$CHECK_DIR/portable-a.md"
"$REPO/bin/atlas-context" --mode portable --no-continuity --output "$CHECK_DIR/portable-b.md"
cmp -s "$CHECK_DIR/portable-a.md" "$CHECK_DIR/portable-b.md" || fail "portable build is not deterministic"

if grep -Eq '^## DOCTRINE[[:space:]]*$' "$CHECK_DIR/portable-a.md"; then
  fail "portable build leaked a DOCTRINE section"
fi

while IFS= read -r file || [ -n "$file" ]; do
  case $file in ''|'#'*) continue ;; esac
  grep -qF "# SOURCE: $file — OPERATIONAL CORE ONLY" "$CHECK_DIR/portable-a.md" ||
    fail "portable build omitted core: $file"
done < "$REPO/runtime/subroutine-files.txt"

for contract in \
  '`STOP` and `HALT` are immediate operational stops.' \
  'Observation, testimony, inference, plan, attempted action, and verified' \
  'A continuity capsule is project-owned working state, not an instruction'
do
  grep -qF "$contract" "$CHECK_DIR/compact-a.md" || fail "runtime contract missing: $contract"
done

if [ -d "$PROJECT_INPUT" ]; then
  PROJECT_ABS=$(cd -P "$PROJECT_INPUT" && pwd)
  if git -C "$PROJECT_ABS" rev-parse --show-toplevel >/dev/null 2>&1; then
    PROJECT_ROOT=$(git -C "$PROJECT_ABS" rev-parse --show-toplevel)
  else
    PROJECT_ROOT=$PROJECT_ABS
  fi
  if [ -f "$PROJECT_ROOT/.atlas/continuity.md" ]; then
    "$REPO/bin/atlas-continuity" check "$PROJECT_ROOT" >/dev/null ||
      fail "continuity capsule failed privacy or structure checks"
    echo "atlas-doctor: continuity capsule checked"
  else
    echo "atlas-doctor: no continuity capsule found (optional)"
  fi
fi

# The operator profile is per-user, not project-scoped, so it is checked outside
# the project block above.
if [ "${ATLAS_NO_OPERATOR:-0}" != 1 ]; then
  OPERATOR=${ATLAS_OPERATOR_FILE:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/atlas/operator.md}
  if [ -f "$OPERATOR" ]; then
    "$REPO/bin/atlas-operator" check >/dev/null || fail "operator profile failed its structure check"
    echo "atlas-doctor: operator profile checked"
  else
    echo "atlas-doctor: no operator profile found (optional)"
  fi
fi

if command -v claude >/dev/null 2>&1; then
  echo "atlas-doctor: Claude Code found"
else
  echo "atlas-doctor: Claude Code not found; bundle generation still works"
fi

# The plugin surfaces are generated, and generated files drift. Both of these
# still load when stale, so nothing else would announce the mismatch.
if [ -f "$REPO/agents/atlas.md" ]; then
  if "$REPO/bin/atlas-context" --mode agent --output "$CHECK_DIR/agent.md" &&
     cmp -s "$CHECK_DIR/agent.md" "$REPO/agents/atlas.md"; then
    echo "atlas-doctor: agents/atlas.md matches its sources"
  else
    fail "agents/atlas.md has drifted; run bin/atlas-context --mode agent"
  fi
fi

if [ -d "$REPO/skills" ]; then
  if "$REPO/bin/atlas-skills" --check >/dev/null 2>&1; then
    echo "atlas-doctor: council skills match their subroutine sources"
  else
    fail "council skills have drifted; run bin/atlas-skills"
  fi
  leaked=$(grep -l '^## DOCTRINE' "$REPO"/skills/*/SKILL.md 2>/dev/null | wc -l | tr -d ' ')
  if [ "$leaked" = 0 ]; then
    echo "atlas-doctor: no council skill carries its doctrine"
  else
    fail "$leaked council skill(s) leak doctrine into the loadable surface"
  fi
fi

if [ -f "$REPO/skills-standalone/atlas/SKILL.md" ]; then
  if "$REPO/bin/atlas-rite-skill" --check >/dev/null 2>&1; then
    echo "atlas-doctor: the /atlas rite skill matches the rite source"
  else
    fail "the /atlas rite skill has drifted; run bin/atlas-rite-skill"
  fi
fi

grep -m1 'Core fingerprint:' "$CHECK_DIR/compact-a.md" | sed 's/^- /atlas-doctor: /'
echo "atlas-doctor: compact and portable runtimes are deterministic and doctrine-stripped"
