#!/bin/sh
# GENERATED by bin/atlas-rite-skill. Do not edit.
set -u
# The marketplace does not install the plugin at cache/<marketplace>/atlas. It
# installs each release into its own version directory beneath it:
#
#   ~/.claude/plugins/cache/scadumen/atlas/1.2.0/level/level.py
#
# A glob stopping at .../atlas therefore lands on a directory that contains only
# version directories and never level/level.py, so the search falls through to
# the hardcoded checkouts below. That fallthrough is silent by design, which is
# exactly how a stale checkout became load-bearing without anyone noticing.
#
# Globbing a level deeper reaches the file but forces a choice: several releases
# can be resident at once, and glob expansion is lexicographic, not semantic.
# python3 rather than `sort -V`: it is already a hard dependency eight lines
# below, so it costs nothing new, and -V is absent from older BSD sort where it
# would fail into silence. Globbing in python also disposes of sh's unmatched-
# glob-stays-literal hazard — no match yields no candidates, not a fake path.
# Versions are compared as integer tuples so 1.10.0 outranks 1.9.0; a name that
# is not purely numeric (a prerelease, say) is skipped rather than guessed at.
newest_cached() {
  python3 - "$HOME/.claude/plugins/cache" <<'PY' 2>/dev/null
import glob, os, sys
best = None
for d in glob.glob(os.path.join(sys.argv[1], '*', 'atlas', '*')):
    if not os.path.isfile(os.path.join(d, 'level', 'level.py')):
        continue
    try:
        key = tuple(int(part) for part in os.path.basename(d).split('.'))
    except ValueError:
        continue
    if best is None or key > best[0]:
        best = (key, d)
if best:
    print(best[1])
PY
}

for dir in \
  ${ATLAS_REPO:+"$ATLAS_REPO"} \
  $(newest_cached) \
  "$HOME"/projects/shadow-atlas \
  "$HOME"/projects/ATLAS
do
  if [ -f "$dir/level/level.py" ]; then
    line=$(python3 "$dir/level/level.py" --oneline 2>/dev/null) || exit 0
    [ -n "$line" ] || exit 0
    ver=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' \
      "$dir/.claude-plugin/plugin.json" 2>/dev/null)
    if [ -n "$ver" ]; then
      printf '%s · v%s\n' "$line" "$ver"
    else
      printf '%s\n' "$line"
    fi
    # Update check — network, bounded, silent. Reachable only when the crown is
    # wound, so the cost never touches an ordinary session. Any failure (offline,
    # slow, moved repo, no git) leaves the readout exactly as it was. The remote
    # URL is read from plugin.json so a repository move needs no edit here, and
    # the comparison lives in level/latest.py, which never touches the network.
    repo=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("repository",""))' \
      "$dir/.claude-plugin/plugin.json" 2>/dev/null)
    if [ -n "$ver" ] && [ -n "$repo" ] && [ -f "$dir/level/latest.py" ]; then
      # The low-speed settings bound a transfer already in flight; they say
      # nothing about DNS or TCP connect, so a blackholed host — a captive
      # portal is the ordinary case — never reaches the stage they govern and
      # hangs indefinitely. git has no connect-timeout config (http.connectTimeout
      # is not a real option), and timeout(1) is absent from a stock macOS, so
      # the ceiling has to be a watchdog. It lands on the crown, the only way
      # into the movement and the one path with nothing behind it to fall
      # through to, so an unbounded wait here is the single failure the rite
      # cannot absorb. Output goes to a file because a backgrounded job cannot
      # be captured by $( ) directly.
      tags=
      tmp=$(mktemp "${TMPDIR:-/tmp}/atlas-tags.XXXXXX" 2>/dev/null) || tmp=
      if [ -n "$tmp" ]; then
        ( GIT_TERMINAL_PROMPT=0 \
          git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=3 \
          ls-remote --tags --refs "$repo" 'atlas--v*' >"$tmp" 2>/dev/null ) &
        gitpid=$!
        ( sleep 5; kill -9 "$gitpid" 2>/dev/null ) >/dev/null 2>&1 &
        watchdog=$!
        wait "$gitpid" 2>/dev/null
        kill -9 "$watchdog" 2>/dev/null
        wait "$watchdog" 2>/dev/null
        tags=$(cat "$tmp" 2>/dev/null)
        rm -f "$tmp"
      fi
      [ -n "$tags" ] && printf '%s\n' "$tags" | \
        python3 "$dir/level/latest.py" "$ver" 2>/dev/null || true
    fi
    exit 0
  fi
done
exit 0
