#!/bin/sh
# GENERATED by bin/atlas-rite-skill. Do not edit.
set -u
# The marketplace does not install the plugin at cache/<marketplace>/atlas. It
# installs each release into its own version directory beneath it:
#
#   ~/.claude/plugins/cache/scadumen/atlas/1.2.0/level/level.py
#
# A glob stopping at .../atlas therefore lands on a directory that contains only
# version directories and never level/level.py, so the search falls through to
# the hardcoded checkouts below. That fallthrough is silent by design, which is
# exactly how a stale checkout became load-bearing without anyone noticing.
#
# Globbing a level deeper reaches the file but forces a choice: several releases
# can be resident at once, and glob expansion is lexicographic, not semantic.
# python3 rather than `sort -V`: it is already a hard dependency eight lines
# below, so it costs nothing new, and -V is absent from older BSD sort where it
# would fail into silence. Globbing in python also disposes of sh's unmatched-
# glob-stays-literal hazard — no match yields no candidates, not a fake path.
# Versions are compared as integer tuples so 1.10.0 outranks 1.9.0; a name that
# is not purely numeric (a prerelease, say) is skipped rather than guessed at.
newest_cached() {
  python3 - "$HOME/.claude/plugins/cache" <<'PY' 2>/dev/null
import glob, os, sys
best = None
for d in glob.glob(os.path.join(sys.argv[1], '*', 'atlas', '*')):
    if not os.path.isfile(os.path.join(d, 'level', 'level.py')):
        continue
    try:
        key = tuple(int(part) for part in os.path.basename(d).split('.'))
    except ValueError:
        continue
    if best is None or key > best[0]:
        best = (key, d)
if best:
    print(best[1])
PY
}

for dir in \
  ${ATLAS_REPO:+"$ATLAS_REPO"} \
  $(newest_cached) \
  "$HOME"/projects/shadow-atlas \
  "$HOME"/projects/ATLAS
do
  if [ -f "$dir/level/level.py" ]; then
    line=$(python3 "$dir/level/level.py" --oneline 2>/dev/null) || exit 0
    [ -n "$line" ] || exit 0
    ver=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' \
      "$dir/.claude-plugin/plugin.json" 2>/dev/null)
    if [ -n "$ver" ]; then
      printf '%s · v%s\n' "$line" "$ver"
    else
      printf '%s\n' "$line"
    fi
    exit 0
  fi
done
exit 0
